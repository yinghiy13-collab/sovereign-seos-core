{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "layer": { "type": "string" },
    "decision": { "enum": ["ALLOW", "DENY"] },
    "status": { "enum": ["PASS", "FAIL", "NOT_RUN"] },
    "evidence_root": { "type": "string" },
    "checks": { "type": "array" }
  },
  "required": ["decision"],
  "additionalProperties": true
}
